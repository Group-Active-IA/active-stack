diff --git a/api/api.go b/api/api.go
index bdb462e..bed5af9 100644
--- a/api/api.go
+++ b/api/api.go
@@ -5,9 +5,12 @@ import "example.com/kv/store"
 
 // Describe devuelve una linea "clave: valor" para mostrar.
 func Describe(s *store.Store, k string) string {
-	v := s.Get(k)
-	if v == "" {
+	v, ok := s.Get(k)
+	switch {
+	case !ok:
 		return k + ": (sin valor)"
+	case v == "":
+		return k + ": (vacío)"
 	}
 	return k + ": " + v
 }
diff --git a/store/store.go b/store/store.go
