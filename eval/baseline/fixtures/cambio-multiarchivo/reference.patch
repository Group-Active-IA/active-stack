--- a/store/store.go
+++ b/store/store.go
@@ -16,7 +16,8 @@ func (s *Store) Set(k, v string) {
 	s.m[k] = v
 }
 
-// Get devuelve el valor de k, o "" si k no existe.
-func (s *Store) Get(k string) string {
-	return s.m[k]
+// Get devuelve el valor de k e indica si k existe.
+func (s *Store) Get(k string) (string, bool) {
